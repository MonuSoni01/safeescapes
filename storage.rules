rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /warranty/{fileName} {
      allow write: if request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
